  "deferred_statement_issues": [
    {
      "declaration": "DLMF.AsymptoticApproximations.laplace_method",
      "issue": "Only local regularity is assumed, while integrability at one parameter does not ensure measurability of the phase-dependent integrands at larger parameters.",
      "counterexample": "Take x0=0, p(t)=t near zero and p=1 or 2 according to a non-Lebesgue-measurable subset of (1,2); q=1 on the finite interval, or q=exp(-t) away from zero on the halfline. The assumed integral exists at x0 but totalized integrals vanish for every x>0, contrary to the nonzero leading coefficient.",
      "proposed_hypothesis": "∀ x, x₀ ≤ x → IntegrableOn (fun t => Real.exp (-x * p t) • q t) (Ioo a b)",
      "source": "Olver, Chapter 3, §§7–8, pp.81–87: absolute convergence for all sufficiently large parameters.",
      "approval": "Pending; original theorem statement and admission left unchanged."
    },
