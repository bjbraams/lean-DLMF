% dlmfnotation.sty -- DLMF notation and link macros for the lean-DLMF reports.
% Load after leanreport.sty (lean-codes/reports), which provides fonts, packages, \lean, \file,
% \repofile and basic notation.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dlmfnotation}[2026/10/26 DLMF notation for lean-DLMF reports]
\RequirePackage{leanreport}

% ---------------------------------------------------------------- links
% \deq{28.28.16}      -> (28.28.16), linked to https://dlmf.nist.gov/28.28.E16
% \DLMF{28.28.16}     -> DLMF (28.28.16)
% \dlink{URL-suffix}{text} -> text linked to https://dlmf.nist.gov/URL-suffix
\makeatletter
\def\deq#1{\deq@split#1\relax}
\def\deq@split#1.#2.#3\relax{\href{https://dlmf.nist.gov/#1.#2.E#3}{(#1.#2.#3)}}
\makeatother
\newcommand{\DLMF}[1]{DLMF~\deq{#1}}
\newcommand{\dlink}[2]{\href{https://dlmf.nist.gov/#1}{#2}}

