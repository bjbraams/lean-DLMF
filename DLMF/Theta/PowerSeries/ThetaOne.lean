module

public import DLMF.Theta.Basic.PowerSeries
public import DLMF.Theta.Basic.Definitions
public import DLMF.Elliptic.Basic.Theta
import DLMF.Theta.PowerSeries.LatticeCoefficients
import DLMF.Weierstrass.Series.LogarithmicSigma
import DLMF.Weierstrass.Relations.ThetaIdentities
import DLMF.Weierstrass.Basic.LatticesAndSigma
import DLMF.JacobiElliptic.QuarterPeriods
import DLMF.Theta.ZeroValues

/-!
# The logarithmic power series of the first Jacobi theta function

DLMF 20.6.2 follows from the regularized logarithmic expansion of the Weierstrass sigma
product on the lattice generated by `1` and `τ`.
-/

public section

set_option maxHeartbeats 0

open Complex PeriodPair Filter DLMF.Weierstrass DLMF.Elliptic
open scoped Real Topology

namespace DLMF.Theta

/-- DLMF 20.6.2: for `|πz| < min |z_{m,n}|`,
`θ₁(πz|τ) = πz θ₁'(0|τ) exp(-∑_{j≥1} δ_{2j}(τ) z^{2j}/(2j))`. -/
@[dlmf 20.6.E2]
theorem jacobiThetaOneTau_powerSeries {τ z : ℂ} (hτ : 0 < τ.im)
    (hz : ‖π * z‖ < thetaLatticeMinNorm τ) :
    ∃ S : ℂ, HasSum (fun j : ℕ => thetaDelta (2 * (j + 1)) τ * z ^ (2 * (j + 1)) /
        (2 * (j + 1))) S ∧
      jacobiThetaOneTau (π * z) τ = π * z * jacobiThetaOneDerivNullTau τ * cexp (-S) := by
  let H := HalfPeriods.ofTau (1 / 2 : ℂ) (by norm_num) ⟨τ, hτ⟩
  have h1 : H.ω₁ = 1 / 2 := rfl
  have h3 : H.ω₃ = τ / 2 := by dsimp only [H, HalfPeriods.ofTau]; ring_nf
  have hHτ : H.tau = τ := by rw [HalfPeriods.tau, h1, h3]; ring_nf
  have hπ : (π : ℂ) ≠ 0 := ofReal_ne_zero.mpr Real.pi_ne_zero
  have hd : jacobiThetaOneDerivNullTau τ ≠ 0 := by
    rw [jacobiThetaOneDerivNullTau_eq_mul hτ]
    exact mul_ne_zero (mul_ne_zero (DLMF.JacobiElliptic.jacobiThetaTwoTau_zero_ne_zero hτ)
      (DLMF.JacobiElliptic.jacobiThetaThreeTau_zero_ne_zero hτ))
      (DLMF.JacobiElliptic.jacobiThetaFourTau_zero_ne_zero hτ)
  have hbound (w : ℂ) (hw : w ∈ H.periodPair.lattice) (hw0 : w ≠ 0) : ‖z‖ < ‖w‖ := by
    obtain ⟨m, n, he⟩ := H.mem_lattice_iff.mp hw
    rw [h1, h3] at he
    have he' : w = (m : ℂ) + n * τ := by linear_combination he
    have hp : (m, n) ≠ (0, 0) := by
      rintro hp
      have hm : m = 0 := congrArg Prod.fst hp
      have hn : n = 0 := congrArg Prod.snd hp
      simp only [hm, hn, Int.cast_zero, zero_mul, zero_add] at he'
      exact hw0 he'
    have hb : BddBelow (Set.range (fun p : {p : ℤ × ℤ // p ≠ 0} =>
        ‖((p.1.1 : ℂ) + p.1.2 * τ) * π‖)) :=
      ⟨0, by rintro _ ⟨p, rfl⟩; exact norm_nonneg _⟩
    have hmin : thetaLatticeMinNorm τ ≤ ‖((m : ℂ) + n * τ) * π‖ :=
      ciInf_le hb ⟨(m, n), hp⟩
    have hh := hz.trans_le hmin
    rw [← he'] at hh
    have hh' : ‖(π : ℂ)‖ * ‖z‖ < ‖(π : ℂ)‖ * ‖w‖ := by
      simpa only [norm_mul, mul_comm] using hh
    exact (mul_lt_mul_iff_of_pos_left (norm_pos_iff.mpr hπ)).mp hh'
  obtain ⟨S, hS, hσ⟩ := weierstrassSigma_eq_exp_sum H.periodPair hbound
  let f : ℕ → ℂ := fun j => thetaDelta (2 * (j + 1)) τ * z ^ (2 * (j + 1)) /
    (2 * (j + 1))
  have htail : HasSum (fun n : ℕ => f (n + 1)) S := by
    convert hS using 1
    funext n
    dsimp only [f]
    rw [show n + 1 + 1 = n + 2 by omega,
      G_eq_thetaDelta H h1 h3 (by omega : 2 < 2 * (n + 2))]
    push_cast
    ring_nf
  have hfull := htail.zero_add
  have hδ := thetaDelta_two_eq_two_eta_one hτ H h1 h3
  have hf0 : f 0 = H.eta 1 * z ^ 2 := by
    dsimp only [f]
    norm_num only [zero_add, Nat.cast_zero, Nat.cast_one, mul_one, pow_one]
    rw [hδ]
    ring_nf
  refine ⟨f 0 + S, hfull, ?_⟩
  have hformula := H.weierstrassSigma_eq_theta z
  rw [h1, hHτ] at hformula
  have hsimp : weierstrassSigma H.periodPair z = cexp (H.eta 1 * z ^ 2) *
      jacobiThetaOneTau (π * z) τ / (π * jacobiThetaOneDerivNullTau τ) := by
    convert hformula using 1
    ring_nf
  have htheta : jacobiThetaOneTau (π * z) τ = π * jacobiThetaOneDerivNullTau τ *
      cexp (-(H.eta 1 * z ^ 2)) * weierstrassSigma H.periodPair z := by
    rw [hsimp, Complex.exp_neg]
    field_simp [hd, hπ, Complex.exp_ne_zero]
  rw [htheta, hσ, hf0]
  have hexp : cexp (-(H.eta 1 * z ^ 2)) * cexp (-S) =
      cexp (-(H.eta 1 * z ^ 2 + S)) := by
    rw [← Complex.exp_add]
    congr 1
    ring_nf
  rw [show π * jacobiThetaOneDerivNullTau τ * cexp (-(H.eta 1 * z ^ 2)) *
      (z * cexp (-S)) = π * z * jacobiThetaOneDerivNullTau τ *
        (cexp (-(H.eta 1 * z ^ 2)) * cexp (-S)) by ring_nf, hexp]

end DLMF.Theta
