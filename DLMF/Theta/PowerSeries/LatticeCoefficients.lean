module

public import DLMF.Theta.Basic.PowerSeries
public import DLMF.Weierstrass.Basic.Functions
import DLMF.Weierstrass.Series
import DLMF.Theta.Identities
import TauCeti.Analysis.Complex.UpperHalfPlane.PeriodPair

/-!
# Theta lattice coefficients and Weierstrass lattice sums

For the lattice generated by `1` and `τ`, the absolutely convergent coefficients `δ_k`
with `k > 2` are the Weierstrass sums `G_k`. The Eisenstein-ordered coefficient `δ₂` equals
`2η₁`; this follows by summing the rows with the cosecant-square identity.
-/

public section

set_option maxHeartbeats 0

open Complex Filter PeriodPair DLMF.Elliptic DLMF.Weierstrass
open scoped Real Topology

namespace DLMF.Theta

/-- The Eisenstein-ordered lattice sum `δ₂` is twice the first Weierstrass quasi-period. -/
lemma thetaDelta_two_eq_two_eta_one {τ : ℂ} (hτ : 0 < τ.im) (H : HalfPeriods)
    (h1 : H.ω₁ = 1 / 2) (h3 : H.ω₃ = τ / 2) : thetaDelta 2 τ = 2 * H.eta 1 := by
  let R : ℂ → ℂ := TauCeti.UpperHalfPlane.rowSum
  have hrow (x : ℂ) (hx : 0 < x.im) : R x = π ^ 2 / sin (π * x) ^ 2 := by
    let q := cexp (2 * π * I * x)
    have hq : ‖q‖ < 1 := by
      dsimp only [q]
      rw [norm_exp, Real.exp_lt_one_iff]
      simpa using (neg_neg_of_pos (mul_pos (mul_pos (by norm_num : (0 : ℝ) < 2)
        Real.pi_pos) hx))
    have hsum := EisensteinSeries.qExpansion_identity (k := 1) le_rfl ⟨x, hx⟩
    simp only [Nat.reduceAdd, pow_one, Nat.factorial_one, Nat.cast_one, div_one] at hsum
    rw [tsum_coe_mul_geometric_of_norm_lt_one hq] at hsum
    have he : cexp (2 * I * (π * x)) = q := by
      dsimp only [q]
      congr 1
      ring_nf
    have hn : 1 - q ≠ 0 := sub_ne_zero.mpr (by
      intro h
      rw [← h, norm_one] at hq
      exact lt_irrefl _ hq)
    have hsin : 1 / sin (π * x) ^ 2 = -4 * q / (1 - q) ^ 2 := by
      have hq0 : q ≠ 0 := exp_ne_zero _
      have hc := DLMF.Theta.exp_two_I_mul_add_inv (π * x)
      rw [he] at hc
      have hs := cos_sub_cos (2 * (π * x)) 0
      rw [show (2 * (π * x) + 0) / 2 = π * x by ring_nf,
        show (2 * (π * x) - 0) / 2 = π * x by ring_nf, cos_zero] at hs
      have h2 : (1 - q) ^ 2 = -4 * q * sin (π * x) ^ 2 := by
        linear_combination q * hc - mul_inv_cancel₀ hq0 + 2 * q * hs
      have hsn : sin (π * x) ^ 2 ≠ 0 := by
        intro heq
        rw [heq, mul_zero] at h2
        exact hn ((pow_eq_zero_iff two_ne_zero).mp h2)
      apply (div_eq_div_iff hsn (pow_ne_zero 2 hn)).2
      simpa only [one_mul] using h2
    dsimp only [R]
    rw [TauCeti.UpperHalfPlane.rowSum_def]
    have hc : (-2 * π * I : ℂ) ^ 2 = -4 * π ^ 2 := by
      linear_combination (4 * (π : ℂ) ^ 2) * I_sq
    rw [hc] at hsum
    rw [hsum]
    calc
      _ = π ^ 2 * (-4 * q / (1 - q) ^ 2) := by ring_nf
      _ = π ^ 2 * (1 / sin (π * x) ^ 2) := by rw [hsin]
      _ = _ := by ring_nf
  have hδ : thetaDelta 2 τ = ∑' n : ℤ, R (n * τ) := by
    unfold thetaDelta
    refine tsum_congr fun n => ?_
    dsimp only [R]
    rw [TauCeti.UpperHalfPlane.rowSum_def]
    refine tsum_congr fun m => ?_
    by_cases h : m = 0 ∧ n = 0
    · rcases h with ⟨rfl, rfl⟩
      simp
    · simp only [h, ite_false]
      rw [zpow_neg, zpow_natCast, one_div, add_comm]
  have hpos : HasSum (fun n : ℕ => R ((n + 1 : ℂ) * τ)) (H.eta 1 - π ^ 2 / 6) := by
    have h := H.eta_one_csc_series
    rw [h1, h3] at h
    convert h using 1
    · funext n
      rw [hrow _ (by simpa using mul_pos (by positivity : (0 : ℝ) < n + 1) hτ)]
      have ht : π * ((n + 1 : ℂ) * τ) =
          (n + 1 : ℂ) * π * (τ / 2) / (1 / 2) := by ring_nf
      rw [ht]
      ring_nf
    · ring_nf
  have hp : HasSum (fun n : ℕ => (fun m : ℤ => R ((m : ℂ) * τ)) (n + 1))
      (H.eta 1 - π ^ 2 / 6) := by
    simpa only [Int.cast_add, Int.cast_natCast, Int.cast_one] using hpos
  have hneg : HasSum (fun n : ℕ => (fun m : ℤ => R ((m : ℂ) * τ)) (-(n + 1)))
      (H.eta 1 - π ^ 2 / 6) := by
    convert hpos using 1
    funext n
    dsimp only [R]
    rw [Int.cast_neg, Int.cast_add, Int.cast_natCast, Int.cast_one, neg_mul,
      TauCeti.UpperHalfPlane.rowSum_neg]
  have hzero : R 0 = π ^ 2 / 3 := by
    change TauCeti.UpperHalfPlane.rowSum 0 = _
    rw [TauCeti.UpperHalfPlane.rowSum_zero, riemannZeta_two]
    ring_nf
  have hfull := HasSum.of_add_one_of_neg_add_one
    (f := fun n : ℤ => R ((n : ℂ) * τ)) hp hneg
  rw [hδ, hfull.tsum_eq]
  simp only [Int.cast_zero, zero_mul, hzero]
  ring_nf

/-- The absolutely convergent lattice sums are the coefficients `δ_k` for `k > 2`. -/
lemma G_eq_thetaDelta {τ : ℂ} (H : HalfPeriods) (h1 : H.ω₁ = 1 / 2)
    (h3 : H.ω₃ = τ / 2) {k : ℕ} (hk : 2 < k) : H.periodPair.G k = thetaDelta k τ := by
  let L := H.periodPair
  let e : ℤ × ℤ ≃ L.lattice :=
    (Equiv.prodComm ℤ ℤ).trans L.latticeEquivProd.symm.toEquiv
  have heval (p : ℤ × ℤ) : ((e p : L.lattice) : ℂ) = (p.2 : ℂ) + p.1 * τ := by
    dsimp only [e, Equiv.trans_apply, Equiv.prodComm_apply]
    change ((L.latticeEquivProd.symm p.swap : L.lattice) : ℂ) = _
    rw [L.latticeEquiv_symm_apply]
    dsimp only [L]
    rw [HalfPeriods.periodPair_ω₁, HalfPeriods.periodPair_ω₂, h1, h3]
    simp only [Prod.swap]
    ring_nf
  have h := L.hasSum_sumInvPow 0 hk
  simp only [sub_zero, L.sumInvPow_zero] at h
  have he := e.hasSum_iff.mpr h
  have hp : HasSum (fun p : ℤ × ℤ => (((p.2 : ℂ) + p.1 * τ) ^ k)⁻¹) (L.G k) := by
    convert he using 1
    funext p
    simp only [Function.comp_apply, heval]
  change L.G k = _
  rw [← hp.tsum_eq, hp.summable.tsum_prod' (fun n => hp.summable.prod_factor n)]
  unfold thetaDelta
  refine tsum_congr fun n => tsum_congr fun m => ?_
  by_cases h0 : m = 0 ∧ n = 0
  · rcases h0 with ⟨rfl, rfl⟩
    simp [show k ≠ 0 by omega]
  · simp only [h0, ite_false, zpow_neg, zpow_natCast]

/-- Shifted absolutely convergent lattice sums give the Weierstrass Taylor coefficients. -/
lemma sumInvPow_eq_shifted_lattice {τ : ℂ} (H : HalfPeriods) (h1 : H.ω₁ = 1 / 2)
    (h3 : H.ω₃ = τ / 2) (a b : ℝ) {k : ℕ} (hk : 2 < k) :
    H.periodPair.sumInvPow ((a : ℂ) + b * τ) k =
      ∑' n : ℤ, ∑' m : ℤ, (((m : ℂ) - a + ((n : ℂ) - b) * τ) ^ k)⁻¹ := by
  let L := H.periodPair
  let e : ℤ × ℤ ≃ L.lattice :=
    (Equiv.prodComm ℤ ℤ).trans L.latticeEquivProd.symm.toEquiv
  have heval (p : ℤ × ℤ) : ((e p : L.lattice) : ℂ) = (p.2 : ℂ) + p.1 * τ := by
    dsimp only [e, Equiv.trans_apply, Equiv.prodComm_apply]
    change ((L.latticeEquivProd.symm p.swap : L.lattice) : ℂ) = _
    rw [L.latticeEquiv_symm_apply]
    dsimp only [L]
    rw [HalfPeriods.periodPair_ω₁, HalfPeriods.periodPair_ω₂, h1, h3]
    simp only [Prod.swap]
    ring_nf
  have h := L.hasSum_sumInvPow ((a : ℂ) + b * τ) hk
  have he := e.hasSum_iff.mpr h
  have hp : HasSum (fun p : ℤ × ℤ =>
      (((p.2 : ℂ) - a + ((p.1 : ℂ) - b) * τ) ^ k)⁻¹)
      (L.sumInvPow ((a : ℂ) + b * τ) k) := by
    convert he using 1
    funext p
    simp only [Function.comp_apply, heval]
    congr 2
    ring_nf
  rw [← hp.tsum_eq, hp.summable.tsum_prod' (fun n => hp.summable.prod_factor n)]

end DLMF.Theta
