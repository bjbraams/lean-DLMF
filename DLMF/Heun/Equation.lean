module

public import DLMF.Heun.Basic
public import Mathlib.Analysis.SpecialFunctions.Pow.Complex
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Cotangent

/-!
# Heun's equation and its automorphisms (DLMF §31.2)

Heun's equation (31.2.1) is `IsHeunSolOn` (DLMF/Heun/Basic.lean). This file records

* its singular points and exponents (§31.2(i)): `0, 1, a, ∞` are at most regular singular
  points with exponents `{0, 1-γ}`, `{0, 1-δ}`, `{0, 1-ε}`, `{α, β}`, stated through the
  singularity classification of `DLMFMathlib.Analysis.ODE.Singularities` and the indicial
  limits; the equivalence with Heun's operator form `𝒟_z w = q w` (31.10.4, proved);
* the normal form (31.2.2–31.2.4) and the trigonometric form (31.2.5–31.2.6);
* the `F`-homotopic and homographic transformations of §31.2(v).

The doubly-periodic forms (§31.2(iv)) are in DLMF/Heun/DoublyPeriodic.lean. All transformation
theorems are stated on open sets on which the principal powers involved are analytic (every
power base in `slitPlane`); other branches differ by constant factors.

The count of 192 automorphisms (§31.2(v), "Composite Transformations") is a remark about the
group generated by the eight `F`-homotopic and 24 homographic maps; it is not acquired as a
statement, only its generators are.
-/

@[expose] public section

open Complex Filter Set
open scoped Topology Real

noncomputable section

namespace DLMF.Heun

variable {a q α β γ δ ε : ℂ}

/-- DLMF 31.10.4 and 31.2.1: away from the singular points, Heun's equation is
`𝒟_z w = q w` for Heun's operator `𝒟_z`. -/
@[dlmf 31.10.E4]
theorem isHeunSolOn_iff_heunOperator {w : ℂ → ℂ} {s : Set ℂ}
    (hs : ∀ z ∈ s, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) :
    IsHeunSolOn a q α β γ δ ε w s ↔ ∀ z ∈ s, DifferentiableAt ℂ w z ∧
      DifferentiableAt ℂ (deriv w) z ∧ heunOperator a α β γ δ ε w z = q * w z := by
  constructor
  · intro h z hz
    obtain ⟨h0, h1, ha⟩ := hs z hz
    have h1' : z - 1 ≠ 0 := sub_ne_zero.2 h1
    have ha' : z - a ≠ 0 := sub_ne_zero.2 ha
    refine ⟨h.1 z hz, (h.2 z hz).differentiableAt, ?_⟩
    rw [heunOperator, (h.2 z hz).deriv]
    unfold heunCoeffP heunCoeffR
    field_simp
    ring
  · intro h
    refine ⟨fun z hz => (h z hz).1, fun z hz => ?_⟩
    obtain ⟨h0, h1, ha⟩ := hs z hz
    have h1' : z - 1 ≠ 0 := sub_ne_zero.2 h1
    have ha' : z - a ≠ 0 := sub_ne_zero.2 ha
    obtain ⟨-, hdd, he⟩ := h z hz
    convert hdd.hasDerivAt using 1
    unfold heunOperator at he
    unfold heunCoeffP heunCoeffR
    field_simp
    linear_combination (-1 : ℂ) * he

/-! ### Singularities and exponents (§31.2(i)) -/

/-- DLMF §31.2(i): for `a ∉ {0, 1}` Heun's equation has at most regular singular points at
`0, 1, a` and `∞` and no other singular points (degenerate parameter values can make a
singular point ordinary or removable, which the predicate `linearODEAtMostRegularAt` allows). -/
@[dlmf 31.2.i]
theorem heun_singularities (ha0 : a ≠ 0) (ha1 : a ≠ 1) :
    Complex.linearODEAtMostRegularAt (heunODECoeff a q α β γ δ ε) 0 ∧
    Complex.linearODEAtMostRegularAt (heunODECoeff a q α β γ δ ε) 1 ∧
    Complex.linearODEAtMostRegularAt (heunODECoeff a q α β γ δ ε) a ∧
    Complex.linearODEAtMostRegularAtInfinity (heunODECoeff a q α β γ δ ε) ∧
    ∀ z : ℂ, z ≠ 0 → z ≠ 1 → z ≠ a →
      Complex.linearODEOrdinaryAt (heunODECoeff a q α β γ δ ε) z := by
  sorry

/-- DLMF §31.2(i): the exponents at `z = 0` are `0` and `1 - γ`. The indicial data
`p₀ = lim z·p(z) = γ` and `q₀ = lim z²·r(z) = 0` give the indicial equation
`ρ(ρ - 1) + γρ = ρ(ρ - (1 - γ))`. The analogous statements at `1` and `a` (exponents
`{0, 1 - δ}` and `{0, 1 - ε}`) follow by the homographies of §31.2(v). -/
@[dlmf 31.2.i]
theorem heun_exponents_zero (ha0 : a ≠ 0) :
    Tendsto (fun z => z * heunCoeffP a γ δ ε z) (𝓝[≠] 0) (𝓝 γ) ∧
    Tendsto (fun z => z ^ 2 * heunCoeffR a q α β z) (𝓝[≠] 0) (𝓝 0) := by
  sorry

/-- DLMF §31.2(i): the exponents at `z = 1` are `0` and `1 - δ`. -/
@[dlmf 31.2.i]
theorem heun_exponents_one (ha1 : a ≠ 1) :
    Tendsto (fun z => (z - 1) * heunCoeffP a γ δ ε z) (𝓝[≠] 1) (𝓝 δ) ∧
    Tendsto (fun z => (z - 1) ^ 2 * heunCoeffR a q α β z) (𝓝[≠] 1) (𝓝 0) := by
  sorry

/-- DLMF §31.2(i): the exponents at `z = a` are `0` and `1 - ε`. -/
@[dlmf 31.2.i]
theorem heun_exponents_a (ha0 : a ≠ 0) (ha1 : a ≠ 1) :
    Tendsto (fun z => (z - a) * heunCoeffP a γ δ ε z) (𝓝[≠] a) (𝓝 ε) ∧
    Tendsto (fun z => (z - a) ^ 2 * heunCoeffR a q α β z) (𝓝[≠] a) (𝓝 0) := by
  sorry

/-- DLMF §31.2(i): the exponents at `∞` are `α` and `β`. For `w ∼ z^{-ρ}` the indicial
equation is `ρ(ρ + 1) - (γ + δ + ε)ρ + αβ = 0`, which under Fuchs's relation
`α + β + 1 = γ + δ + ε` is `(ρ - α)(ρ - β) = 0`. -/
@[dlmf 31.2.i]
theorem heun_exponents_infinity :
    Tendsto (fun z => z * heunCoeffP a γ δ ε z) (Bornology.cobounded ℂ) (𝓝 (γ + δ + ε)) ∧
    Tendsto (fun z => z ^ 2 * heunCoeffR a q α β z) (Bornology.cobounded ℂ) (𝓝 (α * β)) := by
  sorry

/-- DLMF §31.2(i): with Fuchs's relation the indicial polynomial at infinity factors as
`(ρ - α)(ρ - β)`. -/
@[dlmf 31.2.i]
theorem heun_indicial_infinity (hF : α + β + 1 = γ + δ + ε) (ρ : ℂ) :
    ρ * (ρ + 1) - (γ + δ + ε) * ρ + α * β = (ρ - α) * (ρ - β) := by
  rw [← hF]; ring

/-! ### Normal form (§31.2(ii)) -/

/-- DLMF 31.2.3: `A + B + C = 0` for the coefficients 31.2.4 of the normal form (stronger than
DLMF: Fuchs's relation is not needed). -/
@[dlmf 31.2.E3, dlmf 31.2.E4]
theorem heunNormal_A_add_B_add_C (ha0 : a ≠ 0) (ha1 : a ≠ 1) :
    heunNormalA a q γ δ ε + heunNormalB a q α β γ δ ε + heunNormalC a q α β γ δ ε = 0 := by
  have h1 : a - 1 ≠ 0 := sub_ne_zero.2 ha1
  unfold heunNormalA heunNormalB heunNormalC
  field_simp
  ring

/-- DLMF 31.2.2–31.2.4: the substitution `w = z^{-γ/2}(z-1)^{-δ/2}(z-a)^{-ε/2} W` takes Heun's
equation to the normal form `W'' = (A/z + B/(z-1) + C/(z-a) + D/z² + E/(z-1)² + F/(z-a)²) W`.
Stated on an open set on which the principal powers are analytic. -/
@[dlmf 31.2.E2, dlmf 31.2.E3]
theorem heun_normalForm (ha0 : a ≠ 0) (ha1 : a ≠ 1) (hF : α + β + 1 = γ + δ + ε)
    {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ∈ slitPlane ∧ z - 1 ∈ slitPlane ∧ z - a ∈ slitPlane) {w W : ℂ → ℂ}
    (hwW : ∀ z ∈ U, w z = z ^ (-γ / 2) * (z - 1) ^ (-δ / 2) * (z - a) ^ (-ε / 2) * W z) :
    IsHeunSolOn a q α β γ δ ε w U ↔
      IsLinearODE2On 0 (fun z => -heunNormalCoeff a q α β γ δ ε z) W U := by
  sorry

/-! ### Trigonometric form (§31.2(iii)) -/

/-- DLMF 31.2.5–31.2.6: with `z = sin²θ`, a solution `W` of Heun's equation gives a solution
`w(θ) = W(sin²θ)` of
`w'' + ((2γ-1)cot θ - (2δ-1)tan θ - ε sin 2θ/(a - sin²θ)) w' + 4(αβ sin²θ - q)/(a - sin²θ) w = 0`.
-/
@[dlmf 31.2.E5, dlmf 31.2.E6]
theorem heun_trigonometricForm (hF : α + β + 1 = γ + δ + ε) {U V : Set ℂ} (hU : IsOpen U)
    (hV : IsOpen V) {W : ℂ → ℂ} (hW : IsHeunSolOn a q α β γ δ ε W U)
    (hVU : ∀ θ ∈ V, Complex.sin θ ^ 2 ∈ U ∧ Complex.sin θ ≠ 0 ∧ Complex.cos θ ≠ 0 ∧
      a - Complex.sin θ ^ 2 ≠ 0) :
    IsLinearODE2On
      (fun θ => (2 * γ - 1) * Complex.cot θ - (2 * δ - 1) * Complex.tan θ -
        ε * Complex.sin (2 * θ) / (a - Complex.sin θ ^ 2))
      (fun θ => 4 * (α * β * Complex.sin θ ^ 2 - q) / (a - Complex.sin θ ^ 2))
      (fun θ => W (Complex.sin θ ^ 2)) V := by
  sorry

/-! ### Automorphisms (§31.2(v)) -/

/-- DLMF §31.2(v), first `F`-homotopic transformation: if `w₁` solves Heun's equation with
`q₁ = q + (aδ + ε)(1 - γ)`, `α₁ = α + 1 - γ`, `β₁ = β + 1 - γ`, `γ₁ = 2 - γ` (and `δ, ε`
unchanged), then `z^{1-γ} w₁(z)` solves it with the original parameters. -/
@[dlmf 31.2.v]
theorem heun_fHomotopic_zero (hF : α + β + 1 = γ + δ + ε) {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ∈ slitPlane ∧ z ≠ 1 ∧ z ≠ a) {w₁ : ℂ → ℂ}
    (hw₁ : IsHeunSolOn a (q + (a * δ + ε) * (1 - γ)) (α + 1 - γ) (β + 1 - γ) (2 - γ) δ ε w₁ U) :
    IsHeunSolOn a q α β γ δ ε (fun z => z ^ (1 - γ) * w₁ z) U := by
  sorry

/-- DLMF §31.2(v), second `F`-homotopic transformation: `(z-1)^{1-δ} w₂(z)` with
`q₂ = q + aγ(1 - δ)`, `α₂ = α + 1 - δ`, `β₂ = β + 1 - δ`, `δ₂ = 2 - δ`. -/
@[dlmf 31.2.v]
theorem heun_fHomotopic_one (hF : α + β + 1 = γ + δ + ε) {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z - 1 ∈ slitPlane ∧ z ≠ 0 ∧ z ≠ a) {w₂ : ℂ → ℂ}
    (hw₂ : IsHeunSolOn a (q + a * γ * (1 - δ)) (α + 1 - δ) (β + 1 - δ) γ (2 - δ) ε w₂ U) :
    IsHeunSolOn a q α β γ δ ε (fun z => (z - 1) ^ (1 - δ) * w₂ z) U := by
  sorry

/-- DLMF §31.2(v), third `F`-homotopic transformation: `(z-a)^{1-ε} w₃(z)` with
`q₃ = q + γ(1 - ε)`, `α₃ = α + 1 - ε`, `β₃ = β + 1 - ε`, `ε₃ = 2 - ε`. -/
@[dlmf 31.2.v]
theorem heun_fHomotopic_a (hF : α + β + 1 = γ + δ + ε) {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z - a ∈ slitPlane ∧ z ≠ 0 ∧ z ≠ 1) {w₃ : ℂ → ℂ}
    (hw₃ : IsHeunSolOn a (q + γ * (1 - ε)) (α + 1 - ε) (β + 1 - ε) γ δ (2 - ε) w₃ U) :
    IsHeunSolOn a q α β γ δ ε (fun z => (z - a) ^ (1 - ε) * w₃ z) U := by
  sorry

/-- DLMF §31.2(v), homography `z̃ = z/a` (one of the six fixing `∞`): if `w̃` solves Heun's
equation with `ã = 1/a`, `q̃ = q/a`, `δ̃ = ε`, `ε̃ = δ`, then `w̃(z/a)` solves the original. -/
@[dlmf 31.2.v]
theorem heun_homography_div (ha0 : a ≠ 0) (hF : α + β + 1 = γ + δ + ε) {U V : Set ℂ}
    (hU : IsOpen U) (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) {w : ℂ → ℂ}
    (hw : IsHeunSolOn (1 / a) (q / a) α β γ ε δ w V) (hUV : ∀ z ∈ U, z / a ∈ V)
    (hV : IsOpen V) :
    IsHeunSolOn a q α β γ δ ε (fun z => w (z / a)) U := by
  sorry

/-- DLMF §31.2(v), homography `z̃ = z/(z-1)` (one of the 18 that move `∞`, with prefactor):
if `w̃` solves Heun's equation with `ã = a/(a-1)`, `q̃ = -(q - aαγ)/(a-1)`,
`β̃ = α + 1 - δ`, `δ̃ = α + 1 - β` (and `α, γ, ε` unchanged), then
`(1-z)^{-α} w̃(z/(z-1))` solves the original equation. -/
@[dlmf 31.2.v]
theorem heun_homography_mobius (ha1 : a ≠ 1) (hF : α + β + 1 = γ + δ + ε) {U V : Set ℂ}
    (hU : IsOpen U) (hV : IsOpen V)
    (hUs : ∀ z ∈ U, 1 - z ∈ slitPlane ∧ z ≠ 0 ∧ z ≠ a ∧ z / (z - 1) ∈ V) {w : ℂ → ℂ}
    (hw : IsHeunSolOn (a / (a - 1)) (-(q - a * α * γ) / (a - 1)) α (α + 1 - δ) γ
      (α + 1 - β) ε w V) :
    IsHeunSolOn a q α β γ δ ε (fun z => (1 - z) ^ (-α) * w (z / (z - 1))) U := by
  sorry

end DLMF.Heun
